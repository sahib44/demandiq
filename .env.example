# Local development only. Replace CHANGE_ME_LOCAL_ONLY consistently in all URLs.
# Use a URL-safe password; copy to ignored .env. Never commit real credentials.
POSTGRES_USER=demandiq
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=demandiq
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://demandiq:CHANGE_ME_LOCAL_ONLY@localhost:5432/demandiq
# Integration tests migrate and clear DemandIQ tables in this dedicated database.
TEST_DATABASE_URL=postgresql+psycopg://demandiq:CHANGE_ME_LOCAL_ONLY@localhost:5432/demandiq_test
DEMANDIQ_DATA_DIR=data
DEMANDIQ_ARTIFACT_DIR=artifacts
DEMANDIQ_LEDGER_DIR=data/evaluation-ledger
# Run API and worker separately; local development has no authentication.
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=60
JOB_POLL_SECONDS=1
MAX_REQUEST_BYTES=1048576
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Phase 2 training-only product ranking; CLI --top-products overrides this.
TOP_PRODUCTS=50

# Full application Compose loopback ports and optional trusted historical bundle.
API_PORT=8000
FRONTEND_PORT=8080
DEMANDIQ_IMAGE_TAG=local
DEMANDIQ_DEMO_BUNDLE_DIR=./.cache/demo-bundle
# Native API root is empty. Compose explicitly supplies /api to its API service.
API_ROOT_PATH=
# Public frontend build configuration; no secrets belong in VITE_* values.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000
